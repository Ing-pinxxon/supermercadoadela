# PostgreSQL.
#  - Neon: Dashboard → Connection string (la versión "pooled").
#  - Railway: pestaña Variables del servicio Postgres.
# En Vercel, si conectas Neon desde Storage, las variables se crean solas y no
# hay que escribir esta; la app también acepta POSTGRES_URL y las demás que
# crea esa integración. La pantalla /instalar dice cuál está usando.
DATABASE_URL="postgresql://usuario:clave@host:5432/basededatos"

# Clave de la tienda: registra pagos, fiados y tareas, pero no ve los totales
# de la semana ni el histórico.
# Si la dejas vacía o borras la línea, la app queda abierta a cualquiera que
# tenga el link (y todo el mundo ve todo).
APP_PIN="1234"

# Clave del administrador: además de lo anterior, ve la semana, el histórico
# y la pantalla /instalar.
APP_PIN_ADMIN="9999"
